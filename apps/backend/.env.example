# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transport_db

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-256-bits
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
BCRYPT_COST_FACTOR=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# SuperAdmin Seeder (required for initial setup)
SUPERADMIN_EMAIL=admin@system.local
SUPERADMIN_PASSWORD=YourSecurePassword123!
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

# Application
APP_NAME=Transport Management System
DEBUG=false
